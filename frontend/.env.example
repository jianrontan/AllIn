# AllIn — FRONTEND environment (Vite).
#
# Copy to `frontend/.env` (git-ignored). Vite reads VITE_* at BUILD time and
# inlines them into the bundle, so EVERYTHING here is PUBLIC by definition —
# never put a secret in a VITE_ var. (The Google OAuth client secret lives only
# in the Cognito console, never in the frontend.)
#     cp frontend/.env.example frontend/.env

# Backend API base URL.
# VITE_API_BASE=http://localhost:5000

# Cognito Hosted-UI ("Sign in with Google"). When unset, the sign-in button
# hides itself, so dev runs fine without auth. These are public IDs.
# VITE_COGNITO_DOMAIN=auth.jianrontan.com
# VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173/auth/callback
