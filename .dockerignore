# Keep the build context (and image) small. Docker honors THIS file, not
# .gitignore, so blueprint DBs (git-ignored but present on disk) must be excluded
# here explicitly -- except the one pinned snapshot the image serves.

.git
.gitignore
.github
node_modules
frontend
docs
*.md
**/__pycache__
*.pyc
*.pyo
*.log

# SQLite sidecars
*.db-wal
*.db-shm

# Blueprint DBs: keep the top-level `blueprint_final.db` (the served default —
# the auto-resolver only globs the top level of analysis/blueprints, not
# snapshots/). Skip the whole snapshots/ tree to save image size.
backend/bot/analysis/blueprints/snapshots/

# Regenerable / large artifacts not needed in the image:
#  - training curves, perf baseline, archived runs
# NOTE: the baked postflop tables (postflop_table_*.npz) ARE shipped in the
# image, not rebuilt at build time -- they're already on disk locally, baking
# them again would add ~5min for an identical result. The Dockerfile's bake
# RUN step is therefore gone; if a future centroid change forces a rebake,
# run scripts/bake_postflop_table.py locally first.
backend/bot/analysis/training_curve
backend/bot/analysis/archive
backend/bot/perf_baseline.pkl

# Tests aren't needed at runtime
backend/bot/tests
