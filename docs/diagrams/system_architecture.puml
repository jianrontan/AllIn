@startuml system_architecture
!theme plain
skinparam componentStyle rectangle
skinparam defaultFontSize 13
skinparam ArrowColor #555555

' AllIn - heads-up Texas Hold'em CFR+ poker AI.
' Blueprint lives in SQLite; Flask API serves a strategy explorer and a
' play-vs-bot game; training is a separate offline process.
'
' Code-level logical architecture. For the deployed "what runs where"
' (Cloudflare + Lightsail + DynamoDB + Cognito + GitHub Actions) see
' infrastructure.puml.

package "Frontend (React + Vite - dev :5173 / prod CF Pages)" {
  [HandExplorer]
  [KeyExplorer]
  [AiGame]
  [Leaderboard]
  [HandRecap]
  [Auth - Cognito + Google]
  [api.js client]
}

package "Backend API (Flask :5000, run from backend/api/)" {
  package "Strategy endpoints" {
    [GET /api/strategy]
    [POST /api/strategy/from-hand]
    [POST /api/strategy/river-solve]
    [GET /api/abstractions]
  }
  package "Game endpoints" {
    [POST /api/game/new]
    [POST /api/game/action]
    [POST /api/game/bot-action]
    [POST /api/game/next-hand]
  }
  package "Account / Leaderboard endpoints" {
    [GET /api/stats]
    [GET /api/leaderboard]
    [GET /api/me]
    [POST /api/player]
    [POST /api/auth/google]
  }
  package "Health" {
    [GET /api/healthz]
  }
}

package "Game core (game/, no Flask imports - transport-agnostic)" {
  [GameSession]
  [BotStrategy\nBlueprintStrategy\nConfidenceAwareStrategy]
  [RangeTracker]
  [SessionStore\nInMemorySessionStore / DynamoDBSessionStore]
  [PlayersStore / GlobalStore / HandsStore\n(memory or DynamoDB)]
}

package "Inference / Bot (bot/)" {
  [GameAdapter]
  [Player\n(PyPokerEngine path)]
}

package "Training (cfr/)  - offline" {
  [BlueprintTrainer]
  [ParallelTrainer]
  [PokerGame]
  [InformationSet]
  [keys.make_info_set_key\naction_char]
}

package "Abstractions (abstractions/)" {
  [CardAbstraction\npreflop pf_0..29 / PostflopV2]
  [sizing.py\n(single source of truth)]
}

package "Phase-4 Subgame (subgame/)" {
  [RiverSubgameSolver]
  [RiverTree]
  [RiverCFR]
  component "TurnSubgameSolver\n(TurnTree / TurnCFR / cfv leaf)\nREVIVED (continual re-solving); gate pending" as TURN #LightGray
}
note bottom of TURN
  Turn solver (M0-M2) cut in-abstraction
  exploitability ~99% but FAILED the
  real-game gate (cross-street range
  inconsistency). REVIVED via continual
  re-solving (1a/1b/1c built); decisive
  gate runs post-retrain. RIVER is served.
end note

package "Evaluation (evaluation/)" {
  [BestResponseEvaluator]
  [LBR / match / cross_match]
}

database "blueprint_<ts>.db\n(SQLite, WAL)" as BP #LightYellow
[BlueprintDB] as DB
[config.resolve_blueprint_path()] as CFG

' ---- Frontend → API ----
[HandExplorer] --> [api.js client]
[KeyExplorer] --> [api.js client]
[AiGame] --> [api.js client]
[Leaderboard] --> [api.js client]
[HandRecap] --> [api.js client]
[Auth - Cognito + Google] --> [api.js client]
[api.js client] --> [GET /api/strategy] : REST (VITE_API_BASE)
[api.js client] --> [POST /api/strategy/from-hand]
[api.js client] --> [POST /api/game/action]
[api.js client] --> [GET /api/leaderboard]
[api.js client] --> [GET /api/me]
[api.js client] --> [POST /api/auth/google]

' ---- Strategy explorer read path ----
[POST /api/strategy/from-hand] --> [GameAdapter] : build key
[GET /api/strategy] --> DB : get_record(key)

' ---- Play-vs-bot path ----
[POST /api/game/new] --> [GameSession]
[POST /api/game/action] --> [GameSession]
[POST /api/game/next-hand] --> [GameSession]
[GameSession] --> [BotStrategy\nBlueprintStrategy\nConfidenceAwareStrategy] : decide()
[GameSession] --> [RangeTracker] : observe / reveal
[GameSession] --> [SessionStore\nInMemorySessionStore / DynamoDBSessionStore] : persist self.data
[GameSession] --> [PlayersStore / GlobalStore / HandsStore\n(memory or DynamoDB)] : record net BB / hand recap / +EV counter
[GameSession] --> [PokerGame] : drive a hand
[BotStrategy\nBlueprintStrategy\nConfidenceAwareStrategy] --> DB : get_average_strategy(key)
[BotStrategy\nBlueprintStrategy\nConfidenceAwareStrategy] --> [keys.make_info_set_key\naction_char]
[RiverSubgameSolver] ..|> [BotStrategy\nBlueprintStrategy\nConfidenceAwareStrategy] : drop-in (river)
[RiverSubgameSolver] --> [RiverTree]
[RiverSubgameSolver] --> [RiverCFR]
[RangeTracker] --> [CardAbstraction\npreflop pf_0..29 / PostflopV2]

' ---- Shared abstractions / keys ----
[GameAdapter] --> [CardAbstraction\npreflop pf_0..29 / PostflopV2]
[GameAdapter] --> [keys.make_info_set_key\naction_char]
[PokerGame] --> [sizing.py\n(single source of truth)]
[CardAbstraction\npreflop pf_0..29 / PostflopV2] --> [sizing.py\n(single source of truth)]

' ---- Training write path ----
[BlueprintTrainer] --> [PokerGame] : simulate hands
[BlueprintTrainer] --> [InformationSet] : update regrets (CFR+)
[BlueprintTrainer] --> [keys.make_info_set_key\naction_char]
[BlueprintTrainer] --> [CardAbstraction\npreflop pf_0..29 / PostflopV2]
[ParallelTrainer] --> [BlueprintTrainer] : worker pool + regret merge
[BlueprintTrainer] --> DB : save_checkpoint() (incremental, resumable)

' ---- Storage resolution ----
DB --> BP : read/write (training) / mode=ro (inference)
CFG --> BP : ALLIN_BLUEPRINT_DB pins the 25M snapshot\n(else: highest total_iterations)
[Player\n(PyPokerEngine path)] --> CFG : load on init
[BestResponseEvaluator] --> DB : score exploitability (mbb/hand)

@enduml
