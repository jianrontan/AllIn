@startuml infoset_key
!theme plain
skinparam defaultFontSize 12

' How a poker situation becomes the canonical info-set key.
' Single source of truth: cfr/keys.py:make_info_set_key + action_char.
' Format includes POSITION so IP and OOP play are learned separately.

start

:hole_cards = [HA, SK] (engine SuitRank);
:community = [CT, DT, S3];
:position = ip (button/SB) or oop (BB);
:street = 0 preflop, 1 flop, 2 turn, 3 river;
:bet_pattern = current-street actions only (resets each street);

partition "Card Abstraction (card_abstractions.py)" {
  if (community empty?) then (yes - preflop)
    :preflop_bucket(hole) returns FINE id pf_0..pf_168 (LOSSLESS - one per canonical hand);
    :postflop_strength = None;
  else (postflop)
    :PostflopV2 = distribution of equity-vs-range over runouts, EMD-clustered to a centroid;
    :postflop_strength = bucket id (20 flop, 16 turn, 10 river served; 30/24/10 retrain);
    :preflop_bucket(hole) still computed, carried in as the FINE id;
  endif
}

partition "Action to pattern char (keys.action_char)" {
  note right
    check    -> k     bet/raise small  -> s
    call     -> c     bet/raise medium -> m
    fold     -> f     bet/raise large  -> l
    overbet  -> o     xlarge open (5BB) -> x
    all-in   -> a
    (RAISES on an unmapped action; never defaults)
  end note
  :e.g. [bet_medium] gives bet_pattern = "m";
}

partition "Key Assembly (keys.make_info_set_key)" {
  if (street == 0 preflop?) then (yes)
    :preflop key = fineBucket _ position _ betPattern  (e.g. pf_27_ip_);
  else (postflop)
    :coarse = FINE_TO_COARSE[fine]  (3x10 exact collapse = imperfect recall);
    :postflop key = coarse _ strength _ position _ street _ betPattern  (e.g. pf_9_5_ip_turn_m);
  endif
}

:return info_set_key (looked up in BlueprintDB by trainer, API, eval, solver);

stop

@enduml
