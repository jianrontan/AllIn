# AllIn — BACKEND environment (LOCAL DEV).
#
# Copy this to `.env` (which is git-ignored) and uncomment what you need:
#     cp .env.example .env
# It is loaded by backend/api/strategy_api.py via python-dotenv ONLY in dev
# (`pip install -r backend/requirements-dev.txt`). load_dotenv uses override=False,
# so a real shell/host env var always wins over this file.
#
# PRODUCTION does NOT use this file — set these as real env vars on the host
# (e.g. Lightsail service env), never committed.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️  SECRETS POLICY — read before pasting keys
#   • AWS access keys: prefer `aws configure` (~/.aws/credentials) locally and an
#     IAM ROLE in prod (no keys in any file). Only fall back to the AWS_* vars
#     below if you truly can't use the credential file / role.
#   • Google OAuth CLIENT SECRET: never goes here (or anywhere in the repo). It
#     lives only in the Cognito Identity-Provider config in the AWS console.
#   • Cognito User Pool ID + App Client ID are PUBLIC (like a publishable key) —
#     fine to put here and in the frontend.
# ─────────────────────────────────────────────────────────────────────────────

# --- Blueprint ---------------------------------------------------------------
# The resolver serves the top-level blueprint_final.db (the 25M snapshot) by
# default; the 30M lives in snapshots/ and is not auto-selected. Set this only to
# override (e.g. point at a specific snapshot).
# ALLIN_BLUEPRINT_DB=backend/bot/analysis/blueprints/snapshots/snap_20260604_114512_25550000.db
# ALLIN_BLUEPRINT_SOURCE=local            # local (default) | s3
# ALLIN_BLUEPRINT_S3_URI=s3://bucket/key  # only when source=s3

# --- Serving / CORS / debug --------------------------------------------------
# ALLIN_CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# ALLIN_DEBUG_OVERLAY=1                    # DEV ONLY: expose the bot-bucket debug overlay
# ALLIN_LOG_LEVEL=INFO

# --- Stores: memory for dev, dynamodb for prod -------------------------------
# ALLIN_SESSION_STORE=memory              # memory | dynamodb
# ALLIN_STORE_BACKEND=memory              # leaderboard stores: memory | dynamodb
# ALLIN_SESSION_TTL_SECONDS=86400
# ALLIN_DYNAMODB_ENDPOINT=http://localhost:8000   # DynamoDB Local (dev) only; unset in prod
# ALLIN_DYNAMODB_TABLE=allin-sessions
# ALLIN_PLAYERS_TABLE=allin-players
# ALLIN_GLOBAL_TABLE=allin-global

# --- AWS (boto3) — only needed when a store is dynamodb ----------------------
# AWS_REGION=us-east-1
# Prefer ~/.aws/credentials or an IAM role over the next two (dev fallback only):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Cognito (Google sign-in) — these IDs are PUBLIC, not secrets ------------
# When any is unset, /api/auth/google returns 503 and gameplay is unaffected.
# ALLIN_COGNITO_REGION=us-east-1
# ALLIN_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# ALLIN_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
