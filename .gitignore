# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Blueprints (trained model outputs) are git-ignored; the sibling
# analysis/abstractions/ (precompute inputs, e.g. bucket centroids) is committed.
backend/bot/analysis/blueprints/
backend/bot/analysis/archive

# Baked postflop lookup tables are large (turn ~126MB) and fully regenerable
# from the committed centroids via scripts/bake_postflop_table.py, so they are
# git-ignored. Only the small centroids (the real inputs) are committed.
backend/bot/analysis/abstractions/postflop_table_*.npz
# .npy mmap extracts (ALLIN_MMAP_POSTFLOP=1): derived from the .npz at runtime, mmap-able.
backend/bot/analysis/abstractions/postflop_table_*.npy

# Seed-compare baseline snapshot: a binary tied to the exact code+abstraction, so
# it goes stale on any abstraction change (sizing/bake/evaluator) and a check
# against a stale committed copy fails misleadingly. Regenerate on demand via
# `python tests/perf_seed_compare.py save perf_baseline.pkl`. Not committed.
backend/bot/perf_baseline.pkl

# Convergence-curve output from scripts/track_training.py -- a runtime data
# artifact that's rewritten every milestone; regenerated by the tracker, not
# committed.
backend/bot/analysis/training_curve/

# Cache
__pycache__/
*.pyc

# Secrets & infrastructure state — NEVER commit these (see the deploy security
# checklist in docs/DEPLOYMENT.md). Secrets live in Lightsail env vars / AWS
# Secrets Manager, not the repo. Terraform state holds resource IDs + sometimes
# embedded secrets.
.env
.env.*
!.env.example

# Python virtualenv (per-developer, never committed). Created via
# `python -m venv .venv` from the repo root.
.venv/
venv/
# Vite's production config is non-secret (VITE_* values ship in the JS bundle
# anyway). Committing it lets local builds + CI both auto-load the same
# values without duplicating them into the workflow file. Only this specific
# file is exempted -- a stray backend/.env.production stays excluded.
!frontend/.env.production
*.pem
*.key
*.p12
*.pfx
aws-credentials.json
.aws/
.envrc
id_rsa*
secrets.json
.docker/config.json
terraform.tfstate
terraform.tfstate.*
.terraform/
ecr-policy.json
ecr-lifecycle.json

# Author-only operational notes (real account IDs, IAM role specifics, runbook
# logs). Public-facing docs go in docs/ directly.
docs/private/